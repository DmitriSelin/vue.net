{
  "name": "vue-dotnet-webpack",
  "version": "0.0.0",
  "description": "Webpack build-tool provider for the Vue.NET bridge.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.4",
    "ts-loader": "^9.5.4",
    "vue-dotnet-base": "link:../Vue.NET.Base",
    "vue-loader": "^17.4.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  }
}
